# Copy to .env.local. Leave VITE_NOTES_CONTRACT empty to run the mock signer and the mock notes store.
VITE_NOTES_CONTRACT=
# NEAR testnet RPC for the contract views (optional).
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com
# Explorer for transaction links (optional).
VITE_NEAR_EXPLORER_URL=https://testnet.nearblocks.io
