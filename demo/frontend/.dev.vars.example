# Copy to .dev.vars for `wrangler pages dev`. Never commit .dev.vars.
NEAR_AI_API_KEY=
# Optional. The default is Qwen/Qwen3.8-27B.
NEAR_AI_MODEL=
# Optional, for /api/voice-command (the voice commands). With it, JEV runs at Typesafe. Without
# it, JEV runs on NEAR AI Cloud with NEAR_AI_API_KEY (above).
TYPESAFE_API_KEY=
# The faucet's function-call key (ed25519:...), for /api/faucet. It can call drip only.
FAUCET_PRIVATE_KEY=
# Optional. The default is seams-faucet.testnet.
FAUCET_ACCOUNT=
# Optional, for /api/faucet. The default is https://test.rpc.fastnear.com.
NEAR_RPC_URL=
# The voice route /api/voice-verify (the multisig page). Use the OutLayer settings of the Seams staging
# verify route: the payment key decides where the voice templates are and which key signs.
VOICE_OUTLAYER_BASE_URL=
VOICE_OUTLAYER_PROJECT=
# The WASM hash of a verifier version with market_bet and the multisig kinds (0.8.0 or later).
VOICE_OUTLAYER_VERSION_KEY=
# Optional: the WASM hash of the `venice` build of the verifier (speech-to-text on Venice AI).
# With it, a call goes to Venice while NEAR AI Whisper is down, or when the request names it.
VOICE_OUTLAYER_VENICE_VERSION_KEY=
VOICE_OUTLAYER_PAYMENT_KEY=
VOICE_OUTLAYER_SECRETS_PROFILE=
VOICE_OUTLAYER_SECRETS_ACCOUNT_ID=
# The posts route /api/x/eligible-posts: the OAuth 1.0a keys of an X account that is enrolled as a
# Community Notes AI Note Writer. All four are required. A Bearer Token does not work here.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Optional. Posts for each call to X (default 10), seconds between calls (default 14400), and
# a language code or "all" (X's default is English).
X_ELIGIBLE_MAX=
X_ELIGIBLE_TTL_SECONDS=
X_ELIGIBLE_LANG=
# Optional. The subjects that the posts route shows, as a comma list. The default is
# science,technology,business,politics. "all" turns the subject filter off. The filter needs a
# JEV key: TYPESAFE_API_KEY or NEAR_AI_API_KEY (above).
X_ELIGIBLE_TOPICS=
