# Copy to .dev.vars for `wrangler pages dev`. Never commit .dev.vars.
NEAR_AI_API_KEY=
# Optional. The default is Qwen/Qwen3.8-27B.
NEAR_AI_MODEL=
# The faucet's function-call key (ed25519:...), for /api/faucet. It can call drip only.
FAUCET_PRIVATE_KEY=
# Optional. The default is seams-faucet.testnet.
FAUCET_ACCOUNT=
# Optional, for /api/faucet and /api/multisig/approve. The default is https://test.rpc.fastnear.com.
NEAR_RPC_URL=
# The voice multisig route /api/voice-verify. Use the OutLayer settings of the Seams staging
# verify route: the payment key decides where the voice templates are and which key signs.
VOICE_OUTLAYER_BASE_URL=
VOICE_OUTLAYER_PROJECT=
# The WASM hash of a verifier version with multisig_propose (0.6.0 or later).
VOICE_OUTLAYER_VERSION_KEY=
VOICE_OUTLAYER_PAYMENT_KEY=
VOICE_OUTLAYER_SECRETS_PROFILE=
VOICE_OUTLAYER_SECRETS_ACCOUNT_ID=
# The two admin signers of /api/multisig/approve: function-call keys (ed25519:...) for approve
# and execute on the multisig contract only.
MULTISIG_ADMIN_A_KEY=
MULTISIG_ADMIN_B_KEY=
# Optional. The defaults are admin-a.seams-v1.testnet, admin-b.seams-v1.testnet and
# multisig.seams-v1.testnet.
MULTISIG_ADMIN_A=
MULTISIG_ADMIN_B=
MULTISIG_CONTRACT=
# The posts route /api/x/eligible-posts: the OAuth 1.0a keys of an X account that is enrolled as a
# Community Notes AI Note Writer. All four are required. A Bearer Token does not work here.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Optional. Posts for each call to X (default 10), seconds between calls (default 28800), and
# a language code or "all" (X's default is English).
X_ELIGIBLE_MAX=
X_ELIGIBLE_TTL_SECONDS=
X_ELIGIBLE_LANG=
# Optional. The subjects that the posts route shows, as a comma list. The default is
# sport,science,technology,business,entertainment. "all" turns the subject filter off. The filter
# needs NEAR_AI_API_KEY (above).
X_ELIGIBLE_TOPICS=
