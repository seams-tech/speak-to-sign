# Copy to .env.local (pnpm dev) or .env.production.local (pnpm build:site), and set the key.

# Required for the Wallet. The publishable key of the Seams project environment that allows
# origins https://seams-voice-intents.pages.dev, and https://localhost:5443 and https://localhost:8443 (Caddy, pnpm dev:https).
# The Speak to pay page at /pay/ uses the same project and key.
VITE_SEAMS_PUBLISHABLE_KEY=
# Optional cross-check: the environment ID of the same project.
VITE_SEAMS_PROJECT_ENVIRONMENT_ID=

# Optional. The defaults are Seams staging and NEAR testnet.
VITE_SEAMS_WALLET_ORIGIN=https://staging.sign.seams.sh
VITE_SEAMS_RELAYER_URL=https://staging.api.wallet.seams.sh
VITE_NOTES_CONTRACT=notes.seams-v1.testnet
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com
VITE_NEAR_EXPLORER_URL=https://testnet.nearblocks.io
