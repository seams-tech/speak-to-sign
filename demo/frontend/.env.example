# Copy to .env.local (pnpm site, pnpm dev) or .env.production.local (pnpm build:site).
# `pnpm site` and `pnpm dev` copy this file to .env.local when .env.local is missing.

# Required for the Wallet. These two values belong to the demo's Seams project environment.
# Both are public: the live site ships them. They work only from the origins that the project
# allows: https://speak-to-sign.pages.dev, https://localhost:5443 and https://localhost:8443
# (Caddy, pnpm site or pnpm dev:https). A site on another origin needs its own Seams project.
VITE_SEAMS_PUBLISHABLE_KEY=pk_dev_7CDxevjYi2YJaNmXAwkGdatwyBxwvDAN
VITE_SEAMS_PROJECT_ENVIRONMENT_ID=proj_mv5fzezy_4ztf60:dev

# Optional. The defaults are Seams staging and NEAR testnet.
VITE_SEAMS_WALLET_ORIGIN=https://staging.sign.seams.sh
VITE_SEAMS_RELAYER_URL=https://staging.api.wallet.seams.sh
VITE_NOTES_CONTRACT=notes.seams-v1.testnet
VITE_MULTISIG_CONTRACT=voice-multisig-2.seams-v1.testnet
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com
VITE_NEAR_EXPLORER_URL=https://testnet.nearblocks.io

# Public audio key of the voice verifier (standard base64 of 32 bytes). With it, /multisig/ seals
# each recording to the verifier before it leaves the browser (verifier 0.12.0 or later, with the
# OutLayer secret PROTECTED_AUDIO_KEY). Print it with: node --env-file=.dev.vars scripts/audio-key.mjs <verdict key>
VITE_VOICE_AUDIO_KEY=swH9imlBy9lASO9868ouz/FUumuZIK9g/3R7QiFl7ig=
