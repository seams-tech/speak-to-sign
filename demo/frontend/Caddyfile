# Local HTTPS for the demo. Passkeys in the Seams Wallet iframe need the app on trusted HTTPS.
# Caddy's local CA signs the certificates (`tls internal`). Its root must be trusted once on
# this machine (`caddy trust`). The Seams key must allow the HTTPS origins below.
{
	admin off
	auto_https disable_redirects
	default_bind 127.0.0.1
	log {
		level ERROR
	}
}

# https://localhost:5443 → the Vite dev server (pnpm dev, port 5173), with hot reload.
# Vite sends /api/* to the summary function (pnpm dev:api, port 8788).
localhost:5443 {
	tls internal
	encode gzip
	reverse_proxy localhost:5173
}

# https://localhost:8443 → the built site (pnpm build:site, then pnpm preview, port 8788):
# Speak-to-Sign at /, Community Notes at /notes/, PR merge at /merge/, Speak to pay at /pay/,
# and /api/summary.
localhost:8443 {
	tls internal
	encode gzip
	reverse_proxy localhost:8788
}
