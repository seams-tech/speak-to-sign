# Copy this file to .env.local (pnpm pay, pnpm dev) or .env.production.local (pnpm run deploy).
# `pnpm pay` and `pnpm dev` copy this file to .env.local when .env.local is missing.

# Required for the Wallet. These two values belong to the demo's Seams project environment.
# Both are public, and they work only from the origins that the project allows. On your machine,
# open https://localhost:5443 (`pnpm pay` from the repo root, or Caddy with `pnpm dev`). Passkeys
# in the Wallet iframe require trusted HTTPS. A deploy on another origin needs its own Seams project.
VITE_SEAMS_PUBLISHABLE_KEY=pk_dev_7CDxevjYi2YJaNmXAwkGdatwyBxwvDAN
VITE_SEAMS_PROJECT_ENVIRONMENT_ID=proj_mv5fzezy_4ztf60:dev

# Optional. The Seams deployment. The defaults are Seams staging, which serves
# the Speak-to-Sign verify route on NEAR testnet.
VITE_SEAMS_WALLET_ORIGIN=https://staging.sign.seams.sh
VITE_SEAMS_RELAYER_URL=https://staging.api.wallet.seams.sh

# Optional. NEAR testnet RPC for the balance check.
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com
