{
  "name": "speak-to-pay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pay a named NEAR testnet account by voice with Seams Speak-to-Sign.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5280",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "deploy": "pnpm build && wrangler pages deploy"
  },
  "dependencies": {
    "@seams/voiceid": "0.70.5",
    "@seams/wallet": "0.70.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
