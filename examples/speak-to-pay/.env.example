# Copy this file to .env.local (pnpm dev) or .env.production.local (pnpm run deploy),
# and fill in the publishable key.

# Required. The publishable key of your Seams project environment (Seams Console).
VITE_SEAMS_PUBLISHABLE_KEY=

# Optional. The environment ID of the same project, as a cross-check.
VITE_SEAMS_PROJECT_ENVIRONMENT_ID=

# Optional. The Seams deployment. The defaults are Seams staging, which serves
# the Speak-to-Sign verify route on NEAR testnet.
VITE_SEAMS_WALLET_ORIGIN=https://staging.sign.seams.sh
VITE_SEAMS_RELAYER_URL=https://staging.api.wallet.seams.sh
# The passkey RP ID (the Wallet host) and the Router A/B signing worker of staging.
VITE_SEAMS_RP_ID=staging.sign.seams.sh
VITE_SEAMS_SIGNING_WORKER_ID=router-ab-signing-worker-staging

# Optional. NEAR testnet RPC for the balance check.
VITE_NEAR_RPC_URL=https://test.rpc.fastnear.com
