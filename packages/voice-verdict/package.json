{
  "name": "@seams/voice-verdict",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Checks what the Speak-to-Sign verifier signed: a verdict, a transcript and the TDX quote of a call. No dependency.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seams-tech/speak-to-sign.git",
    "directory": "packages/voice-verdict"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.2.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
